# Deployment template — copy to the hosting provider's environment settings.
# Do not replace the local .env with this file.
NEXT_PUBLIC_SITE_URL=https://luatvukhang.com
NEXT_PUBLIC_DEMO_MODE=false
SITE_LAUNCH_APPROVED=false
DATABASE_URL=file:./.local/law.db
PAYLOAD_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFICATION_EMAIL=

# Dat "true" neu cong ty co y KHONG dung email thong bao. Khi do release-check
# khong con chan vi thieu SMTP, nhung phai co nguoi mo /admin > Yeu cau tu van
# hang ngay: khach gui yeu cau se khong ai duoc bao tu dong.
EMAIL_NOTIFICATIONS_DISABLED=

# Only enable behind a proxy that overwrites inbound forwarding headers.
TRUST_PROXY_HEADERS=false
# Additional origins accepted by the consultation form, comma-separated.
ALLOWED_FORM_ORIGINS=
NEXT_PUBLIC_ANALYTICS_ID=
SITE_VERIFICATION_GOOGLE=
SITE_VERIFICATION_BING=

# Dịch máy cho trang quản trị (Anthropic). Để trống thì nút dịch báo "chưa cấu hình".
ANTHROPIC_API_KEY=
